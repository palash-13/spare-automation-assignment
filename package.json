{
  "name": "spare-automation",
  "type": "module",
  "private": true,
  "scripts": {
    "test:api": "bun test api",
    "test:api:report": "bun scripts/api-report.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test": "bun run test:api:report && bun run test:e2e",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
